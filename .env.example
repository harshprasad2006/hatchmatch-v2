# Gemini AI Studio API Key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Firebase Admin SDK Credentials Path
FIREBASE_KEY_PATH=secrets/firebase-key.json

# Search Flags
USE_GROUNDING=false
OPENALEX_API_KEY=your_openalex_api_key_here
